{
  "name": "ego-chatgpt-api",
  "version": "1.0.0",
  "description": "基于 ego-browser 真实 Chromium 会话的原生免封控 ChatGPT OpenAI 兼容 API 桥接服务",
  "main": "server.mjs",
  "type": "module",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./start-server.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File ./stop-server.ps1",
    "autostart:enable": "powershell -ExecutionPolicy Bypass -File ./install-autostart.ps1",
    "autostart:disable": "powershell -ExecutionPolicy Bypass -File ./uninstall-autostart.ps1",
    "sync": "powershell -ExecutionPolicy Bypass -File ./sync.ps1 -Now",
    "sync:watch": "powershell -ExecutionPolicy Bypass -File ./sync.ps1 -Daemon",
    "test": "node ./test-api.mjs",
    "test:unit": "node ./test-unit.mjs",
    "test:mock": "node ./test-mock.mjs",
    "test:suno": "node ./test-suno.mjs"
  },
  "keywords": [
    "chatgpt",
    "openai",
    "ego-browser",
    "api-bridge",
    "anti-cloudflare",
    "stream-sse"
  ],
  "author": "luoluoluo22 <1137583371@qq.com>",
  "license": "MIT"
}
