# Copy this file to .env and replace the placeholder with a long random token.
# When set, chat completions, /logs, /shutdown and Suno API endpoints require this key.
EGO_API_KEY=replace-with-a-long-random-token
# Optional: EGO_API_PORT=8765
# Optional: EGO_MAX_BODY_BYTES=2097152
# Optional: EGO_MAX_QUEUE_LENGTH=32

# 启用的服务提供者（逗号分隔，默认 chatgpt,suno）
# EGO_PROVIDERS=chatgpt,suno

# Suno 相关配置
# EGO_SUNO_URL=https://suno.com/create?wid=default
# EGO_SUNO_TASK_SPACE_ID=Suno-Bridge-Default
